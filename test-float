
<!DOCTYPE html>

<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>流通股測試</title>
</head>
<body style="padding:20px;font-family:sans-serif;background:#f5e8a0;">
<h2>流通股數量測試</h2>
<button onclick="test()" style="background:#0066bb;color:white;border:none;border-radius:8px;padding:12px 24px;font-size:16px;cursor:pointer;">測試 IONQ + LUNR</button>
<div id="result" style="margin-top:20px;padding:16px;background:white;border-radius:10px;font-size:13px;display:none;white-space:pre-wrap;"></div>

<script>
const K='d745a41r01qno4q0h68gd745a41r01qno4q0h690';

async function fetchProfile(t){
  var r=await fetch('https://finnhub.io/api/v1/stock/profile2?symbol='+t+'&token='+K);
  return r.json();
}

async function test(){
  var d=document.getElementById('result');
  d.style.display='block';
  d.innerHTML='⏳ 載入中...';
  
  var result='';
  for(var t of ['IONQ','LUNR','RKLB','PL']){
    try{
      var p=await fetchProfile(t);
      result+=t+'\n';
      result+='  流通股: '+(p.shareOutstanding||'無數據')+' 百萬股\n';
      result+='  市值: $'+(p.marketCapitalization||'無數據')+'M\n\n';
    }catch(e){
      result+=t+' 錯誤: '+e.message+'\n\n';
    }
    await new Promise(r=>setTimeout(r,300));
  }
  
  d.innerHTML=result||'無數據';
  d.style.color='#1a1a2e';
}
</script>

</body>
</html>
